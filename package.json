{
  "name": "breev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.23.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.23.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "check:licence-artifact": "node tooling/licensing/check-artifact.mjs",
    "check:licence-signing-key": "node tooling/licensing/check-signing-key.mjs",
    "check:boundaries": "node tooling/boundaries/check.mjs",
    "dev": "pnpm start:local",
    "dev:main": "node tooling/dev.mjs main",
    "dev:terminal": "node tooling/dev.mjs terminal",
    "env:check": "node tooling/check-local-env.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && pnpm check:boundaries",
    "package:desktop": "pnpm --filter @breev/desktop package",
    "package:windows": "pnpm build && pnpm package:windows:payload && pnpm --filter @breev/desktop package:windows",
    "package:windows:payload": "node apps/local-api/windows/prepare-payload.mjs",
    "start:local": "pnpm env:check && turbo run start --filter=@breev/local-api --filter=@breev/desktop",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:browser && pnpm test:smoke",
    "test:boundaries": "node tooling/boundaries/prove.mjs",
    "test:browser": "pnpm build && pnpm --filter @breev/desktop test:browser",
    "test:dev-launcher": "node --test tooling/dev-launcher.test.mjs",
    "test:integration": "turbo run test:integration --filter=@breev/local-api",
    "test:licence-generator": "pnpm --filter @breev/local-api exec vitest run --config vitest.unit.config.ts src/licensing/dev-licence-generator.unit.test.ts && pnpm --filter @breev/desktop exec playwright test test/browser/licence-generator.browser.test.ts --config playwright.browser.config.ts",
    "test:smoke": "pnpm build && pnpm --filter @breev/desktop test:smoke",
    "test:unit": "turbo run test:unit && pnpm test:boundaries && pnpm test:dev-launcher",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm check:licence-artifact && pnpm test:unit && pnpm test:integration && pnpm test:browser && pnpm test:smoke"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.9.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "turbo": "2.10.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
