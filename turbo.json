{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "dependsOn": ["build", "^build"],
      "persistent": true
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["build", "^build"]
    },
    "test:smoke": {
      "cache": false,
      "dependsOn": ["build", "^build"]
    },
    "test:unit": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
