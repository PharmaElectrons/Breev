{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "dependsOn": ["build", "^build"],
      "passThroughEnv": [
        "API_HOST",
        "API_PORT",
        "BREEV_*",
        "DATABASE_MIGRATION_URL",
        "DATABASE_URL"
      ],
      "persistent": true
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["build", "^build"]
    },
    "test:smoke": {
      "cache": false,
      "dependsOn": ["build", "^build"]
    },
    "test:unit": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
