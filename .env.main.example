# Breev Main Pharmacy Computer configuration template.
# Copy this file to .env when running as the Main device hosting the local API, database, and desktop UI.

# ==============================================================================
# Local API Service Configuration
# ==============================================================================
API_HOST=127.0.0.1
API_PORT=31310

# ==============================================================================
# PostgreSQL Connection Strings
# Breev requires two distinct roles:
# 1. breev_app (runtime application role with least privileges on public/pgboss)
# 2. breev_schema_owner (migration role used during startup schema migrations)
# ==============================================================================
DATABASE_URL=postgresql://breev_app:app_secret_password@127.0.0.1:5432/breev_local
DATABASE_MIGRATION_URL=postgresql://breev_schema_owner:migrator_secret_password@127.0.0.1:5432/breev_local

# ==============================================================================
# Main Device Security & Credentials
# Required for desktop app and local API mutual authentication.
# - BREEV_MAIN_DEVICE_ID must be a UUIDv7
# - BREEV_MAIN_DEVICE_SECRET must be a 32-byte base64url string (43 characters)
# - BREEV_MAIN_DEVICE_SESSION must be a 32-byte base64url string (43 characters)
# ==============================================================================
BREEV_MAIN_DEVICE_ID=
BREEV_MAIN_DEVICE_SECRET=
BREEV_MAIN_DEVICE_SESSION=

# ==============================================================================
# Desktop Application Configuration (Main Device Role)
# ==============================================================================
BREEV_DEVICE_ROLE=main
BREEV_LOCAL_API_URL=http://127.0.0.1:31310

# ==============================================================================
# Optional Runtime Settings & LAN Pairing Service (defaults shown)
# ==============================================================================
# DATABASE_URL_FILE=/path/to/database_url_file
# BREEV_BACKUP_DIRECTORY=/var/lib/breev/backups
# BREEV_INSTALLATION_STATE=ready
# BREEV_PROOF_RATE_LIMIT=5
# BREEV_PROOF_RATE_WINDOW_SECONDS=60
# BREEV_AUTH_RATE_LIMIT=5
# BREEV_AUTH_RATE_WINDOW_SECONDS=60
BREEV_LAN_API_HOST=127.0.0.1
BREEV_LAN_API_PORT=31311
