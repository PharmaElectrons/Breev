# Breev desktop configuration.
# Copy this file to apps/desktop/.env. Match the values in the root .env.

# ==============================================================================
# Local API Connection
# Loopback URL where the local NestJS API is listening.
# ==============================================================================
BREEV_LOCAL_API_URL=http://127.0.0.1:31310

# ==============================================================================
# Main Device Credentials
# Must match the credentials configured in the local API.
# - BREEV_MAIN_DEVICE_ID must be a UUIDv7
# - BREEV_MAIN_DEVICE_SECRET must be a 32-byte base64url string (43 characters)
# - BREEV_MAIN_DEVICE_SESSION must be a 32-byte base64url string (43 characters)
# ==============================================================================
BREEV_MAIN_DEVICE_ID=
BREEV_MAIN_DEVICE_SECRET=
BREEV_MAIN_DEVICE_SESSION=

# ==============================================================================
# Device Role
# Leave unset (or "main") for the Main Pharmacy Computer.
# Set to "terminal" to run this machine as an Additional POS Terminal. In the
# terminal role the Main device credentials above are not used: the terminal
# authenticates with the device certificate it receives while pairing, and the
# renderer reaches the Main installation through a loopback bridge the desktop
# main process opens on a random port.
# A terminal requires BREEV_TERMINAL_STATE_DIR outside Windows. On a packaged
# Windows terminal the state lives in %ProgramData%\Breev\config\terminal.
# The directory holds terminal-device.json and terminal-device.key. The private
# key is encrypted with the operating system key store when it is available and
# the binding records which protection was used.
# ==============================================================================
# BREEV_DEVICE_ROLE=terminal
# BREEV_TERMINAL_STATE_DIR=/var/lib/breev/terminal
# BREEV_TERMINAL_DEVICE_NAME=Counter 2

# ==============================================================================
# Optional Desktop Settings (defaults shown commented)
# ==============================================================================
# BREEV_WINDOWS_BUILD_VERSION=0.0.0
# BREEV_WINDOWS_CERTIFICATE_FILE=
# BREEV_WINDOWS_CERTIFICATE_PASSWORD=
# BREEV_WINDOWS_REQUIRE_SIGNING=0

# Optional support handoff. Configure only an approved destination. Email takes
# precedence when both are set; the portal must be credential-free HTTPS.
# BREEV_SUPPORT_EMAIL=
# BREEV_SUPPORT_PORTAL_URL=

# External diagnostic reporting is disabled by default. Enabling it requires
# the unresolved G-08/G-14/G-16 privacy, region, and release approvals. The
# renderer can submit only by explicit operator action; no background upload,
# attachments, replay, traces, screenshots, or user context are collected.
# BREEV_DIAGNOSTIC_REPORTING=manual
# BREEV_SENTRY_DSN=
