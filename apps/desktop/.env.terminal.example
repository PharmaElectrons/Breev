# Breev Desktop configuration — Additional POS Terminal role template.
# Copy this file to apps/desktop/.env when running the desktop app as a secondary POS terminal.

# ==============================================================================
# Device Role
# ==============================================================================
BREEV_DEVICE_ROLE=terminal

# ==============================================================================
# Terminal State & Identification
# A terminal keeps its device certificate, the pinned pharmacy authority, and
# its private key in BREEV_TERMINAL_STATE_DIR.
# On Windows installations, defaults to %ProgramData%\Breev\config\terminal.
# ==============================================================================
BREEV_TERMINAL_STATE_DIR=/var/lib/breev/terminal
BREEV_TERMINAL_DEVICE_NAME=Counter 2

# ==============================================================================
# Optional Desktop Settings (defaults shown commented)
# ==============================================================================
# BREEV_WINDOWS_BUILD_VERSION=0.0.0
# BREEV_WINDOWS_CERTIFICATE_FILE=
# BREEV_WINDOWS_CERTIFICATE_PASSWORD=
# BREEV_WINDOWS_REQUIRE_SIGNING=0
