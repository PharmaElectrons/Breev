{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "types": ["node", "electron-vite/node"]
  },
  "include": [
    "electron.vite.config.ts",
    "playwright.acceptance.config.ts",
    "playwright.browser.config.ts",
    "playwright.config.ts",
    "scripts/**/*.mjs",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/renderer/src/preferences.ts",
    "src/renderer/src/patients/patient-messages.ts",
    "test/**/*.ts",
    "vitest.config.ts"
  ]
}
