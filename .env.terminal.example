# Breev Additional POS Terminal configuration.
# Use this file as apps/desktop/.env (or .env on a terminal machine) when running as a secondary POS terminal.
# A terminal does NOT run a local API or PostgreSQL database; it connects to the Main Pharmacy Computer over the LAN via mTLS.

# ==============================================================================
# Device Role & Terminal Identity
# ==============================================================================
BREEV_DEVICE_ROLE=terminal
BREEV_TERMINAL_STATE_DIR=d:\Cefeldeen-clinic-pos\breef\.terminal-state
BREEV_TERMINAL_DEVICE_NAME=Terminal 1

# ==============================================================================
# Optional Desktop Settings (defaults shown commented)
# ==============================================================================
# BREEV_WINDOWS_BUILD_VERSION=0.0.0
# BREEV_WINDOWS_CERTIFICATE_FILE=
# BREEV_WINDOWS_CERTIFICATE_PASSWORD=
# BREEV_WINDOWS_REQUIRE_SIGNING=0
